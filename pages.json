{
	"easycom": {
		"autoscan": true, // 是否自动扫描组件
		"custom": { // 自定义扫描规则
			"^uni-(.*)": "@/uview-ui/components/u-$1/u-$1.vue"
		}
	},
	"pages": [ //pages数组中第一项表示应用启动页，参考：https://uniapp.dcloud.io/collocation/pages
		{
			"path": "pages/index/index",
			"style": {
				"navigationBarTitleText": "烤帝",
				"navigationStyle": "custom",
				"navigationBarTextStyle": "white"
			}
		},
		{
			"path": "pages/user/index",
			"style": {
				"navigationBarBackgroundColor": "#f8785f",
				"navigationBarTextStyle": "white",
				"navigationBarTitleText": "我的",
				"navigationStyle": "custom"
			}
		},
		{
		    "path" : "pages/login/login",
		    "style" :                                                                                    
		    {
		        "navigationBarTitleText": "",
		        "enablePullDownRefresh": false,
				"navigationStyle": "custom"
		    }
		    
		}
	],
	"subPackages": [{
		"root": "pages/my",
		"pages": [{
			"path": "project",
			"style": {
				"navigationBarTitleText": "选择进货项目"
			}
		}, {
			"path": "stock",
			"style": {
				"navigationBarTitleText": "进货"
			}
		}, {
			"path": "stock1",
			"style": {
				"navigationBarTitleText": "编辑进货"
			}
		},{
			"path": "record",
			"style": {
				"navigationBarTitleText": "进货记录",
				"enablePullDownRefresh": false
			}

		}    ,{
                    "path" : "details",
                    "style" :                                                                                    
                {
                    "navigationBarTitleText": "进货详情",
                    "enablePullDownRefresh": false
                }
                
                }
                ,{
                    "path" : "statistics",
                    "style" :                                                                                    
                {
                    "navigationBarTitleText": "统计",
                    "enablePullDownRefresh": false
                }
                
                }
                ,{
                    "path" : "escalation",
                    "style" :                                                                                    
                {
                    "navigationBarTitleText": "上报数据",
                    "enablePullDownRefresh": false
                }
                
                }
                ,{
                    "path" : "noticeDetails",
                    "style" :                                                                                    
                {
                    "navigationBarTitleText": "公告详情",
                    "enablePullDownRefresh": false
                }
                
                }
                ,{
                    "path" : "noticeList",
                    "style" :                                                                                    
                {
                    "navigationBarTitleText": "公告列表",
                    "enablePullDownRefresh": false
                }
                
                }
                ,{
                    "path" : "message",
                    "style" :                                                                                    
                {
                    "navigationBarTitleText": "消息列表",
                    "enablePullDownRefresh": false
                }
                
                }
                ,{
                    "path" : "inventory",
                    "style" :                                                                                    
                {
                    "navigationBarTitleText": "剩余库存",
                    "enablePullDownRefresh": false
                }
                
                }
            ]
	}],
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "首页",
		"navigationBarBackgroundColor": "#FFFFFF",
		"backgroundColor": "#F8F8F8"
	},
	"tabBar": {
		"color": "#9d9d9d",
		"selectedColor": "#f8785f",
		"backgroundColor": "#FFFFFF",
		"list": [{
			"text": "首页",
			"pagePath": "pages/index/index",
			"iconPath": "static/tabBar/index.png",
			"selectedIconPath": "static/tabBar/index6.png"
		}, {
			"text": "我的",
			"pagePath": "pages/user/index",
			"iconPath": "static/tabBar/user.png",
			"selectedIconPath": "static/tabBar/user6.png"
		}]
	}
}
